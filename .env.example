# CLIP
CLIP_MODEL_NAME=openai/clip-vit-base-patch32
SIMILARITY_THRESHOLD=0.90

# REL-DUP: exact-media dedupe (POST /dedupe) — stricter than SIMILARITY_THRESHOLD
# above, which is for the broader "semantically similar" /similar endpoint.
# A pair is treated as the same media if EITHER holds:
#   - CLIP cosine >= DEDUPE_SIMILARITY_THRESHOLD, OR
#   - pHash Hamming distance <= DEDUPE_HASH_MAX_DISTANCE (0..64, 8x8 hash)
DEDUPE_SIMILARITY_THRESHOLD=0.97
DEDUPE_HASH_MAX_DISTANCE=10

# Qdrant — inside Compose use the service hostname (not localhost)
QDRANT_URL=http://qdrant:6333
# Host-published Qdrant port (optional; for host-side tools / dashboard)
QDRANT_PORT=6333
COLLECTION_NAME=image_embeddings

# FastAPI — host port mapped to container :8000
APP_PORT=3020

# Max upload size for POST /embed (bytes). Default 10 MiB.
MAX_UPLOAD_BYTES=10485760

# Bulk import (scripts/import_wisgoon_posts.py) — path to main Wisgoon SDK config
# (credentials live only in that YAML; not duplicated here)
WISGOON_CONNECTIONS_YAML=/home/mostafa/Documents/wisgoon/sdk/configs/production/connections.yaml
WISGOON_DSN_KEY=read_db

# Public Wisgoon HTTP (for /similar when post missing locally)
WISGOON_POST_ITEM_URL=https://gateway.wisgoon.com/api/v9/post/item/{uid}/
WISGOON_WEB_BASE=https://wisgoon.com
