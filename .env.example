# CLIP model (HuggingFace id)
CLIP_MODEL_NAME=openai/clip-vit-base-patch32

# Cosine similarity threshold for considering two images as duplicates
SIMILARITY_THRESHOLD=0.90

# Qdrant (used from phase 2 onward)
QDRANT_HOST=localhost
QDRANT_PORT=6333
COLLECTION_NAME=image_embeddings
# alias kept for older scripts / compose
QDRANT_COLLECTION=image_embeddings
